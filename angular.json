{
  "projects": {
    "app": {
      "architect": {
        "build": {
          "configurations": {
            "production": {
              "outputPath": "dist/rescue-app",
              "optimization": true,
              "sourceMap": false,
              "extractLicenses": true,
              "vendorChunk": false,
              "buildOptimizer": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "5mb"
                }
              ]
            }
          }
        }
      }
    }
  }
}